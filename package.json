{
  "name": "pi-crofai-provider",
  "version": "1.0.6",
  "description": "DEPRECATED: CrofAI provider (archived). See DEPRECATION.md.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "crofai",
    "provider"
  ],
  "author": {
    "name": "Dawid Machon",
    "url": "https://github.com/dawidmachon"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawidmachon/pi-crofai-provider.git"
  },
  "bugs": {
    "url": "https://github.com/dawidmachon/pi-crofai-provider/issues"
  },
  "homepage": "https://github.com/dawidmachon/pi-crofai-provider#readme",
  "files": [
    "index.ts",
    "models.snapshot.json",
    "curations.json",
    "README.md",
    "DEPRECATION.md",
    "sorry.txt",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selfcheck": "node --experimental-strip-types test/selfcheck.ts",
    "check": "npm run typecheck && npm run selfcheck",
    "update-models": "node scripts/update-models.mjs snapshot",
    "probe-models": "node scripts/update-models.mjs probe"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
